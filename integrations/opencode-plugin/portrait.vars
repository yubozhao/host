# Values for integrations/portrait-spec/lead.md in this package (sync.sh).
# An OpenCode plugin (an ES module): its config hook adds the six steps as
# commands, from commands/*.md, with <plugin-root> replaced by the plugin's
# own folder. OpenCode's headless run is not checked here for read-only
# runs, so the portrait's own model runs use another CLI (RUNNER=auto).
LEAD=OpenCode
LEAD_ID=opencode
RUNNER=auto
SCRIPT="<plugin-root>/scripts/portrait-agents"
PORTRAIT_COMMAND=/portrait-build
AS_ME_COMMAND=/portrait-do
FIDELITY_COMMAND=/portrait-fidelity
PUBLISH_COMMAND=/portrait-publish
JOBS_COMMAND=/portrait-jobs
COMMANDS_DIR=integrations/opencode-plugin/commands
COMMANDS_FORMAT=md
