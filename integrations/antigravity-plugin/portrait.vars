# Values for integrations/portrait-spec/lead.md in this package (sync.sh).
# Antigravity CLI (agy) installs this folder at
# ~/.gemini/config/plugins/portrait/. Skill names carry a portrait- prefix
# (SKILL_PREFIX), since agy shows plugin skills by bare name. The portrait's own model runs use another CLI (RUNNER=auto)
# until agy's headless read-only mode is checked.
LEAD=Antigravity
LEAD_ID=antigravity
RUNNER=auto
SCRIPT="$HOME/.gemini/config/plugins/portrait/scripts/portrait-agents"
PORTRAIT_COMMAND=/portrait-build
AS_ME_COMMAND=/portrait-do
FIDELITY_COMMAND=/portrait-fidelity
PUBLISH_COMMAND=/portrait-publish
JOBS_COMMAND=/portrait-jobs
SKILL_PREFIX=portrait-
