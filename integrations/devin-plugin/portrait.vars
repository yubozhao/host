# Values for integrations/portrait-spec/lead.md in this package (sync.sh).
# Devin Local (Devin Desktop and the devin CLI, formerly Windsurf) installs
# this folder: devin plugins install yubozhao/host#integrations/devin-plugin.
# It expands no plugin-root variable in skill text, so each skill says how to
# find the plugin folder. The portrait's own model runs use another CLI.
LEAD=Devin
LEAD_ID=devin
RUNNER=auto
SCRIPT="<plugin-root>/scripts/portrait-agents"
PORTRAIT_COMMAND=/portrait-build
AS_ME_COMMAND=/portrait-do
FIDELITY_COMMAND=/portrait-fidelity
PUBLISH_COMMAND=/portrait-publish
JOBS_COMMAND=/portrait-jobs
SKILL_PREFIX=portrait-
