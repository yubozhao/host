# Values for integrations/portrait-spec/lead.md in this package (sync.sh).
# Gemini CLI installs the repository root as the extension, so its commands
# live in the root commands/portrait/ folder and render there.
LEAD=Gemini
LEAD_ID=gemini
SCRIPT="$HOME/.gemini/extensions/portrait/integrations/gemini-extension/scripts/portrait-agents"
PORTRAIT_COMMAND=/portrait:build
AS_ME_COMMAND=/portrait:do
FIDELITY_COMMAND=/portrait:fidelity
PUBLISH_COMMAND=/portrait:publish
JOBS_COMMAND=/portrait:jobs
COMMANDS_DIR=commands/portrait
