# Values for integrations/portrait-spec/lead.md in this package (sync.sh).
# Kimi Code CLI installs the repository root as the plugin (copied to
# $KIMI_CODE_HOME/plugins/managed/portrait/), so the root .kimi-plugin/plugin.json
# points at these commands. Kimi's prompt mode runs shell commands without
# asking, so the portrait's own model runs use another CLI (RUNNER=auto).
LEAD=Kimi
LEAD_ID=kimi
RUNNER=auto
SCRIPT="${KIMI_CODE_HOME:-$HOME/.kimi-code}/plugins/managed/portrait/integrations/kimi-plugin/scripts/portrait-agents"
PORTRAIT_COMMAND=/portrait:build
AS_ME_COMMAND=/portrait:do
FIDELITY_COMMAND=/portrait:fidelity
PUBLISH_COMMAND=/portrait:publish
JOBS_COMMAND=/portrait:jobs
COMMANDS_DIR=integrations/kimi-plugin/commands
COMMANDS_FORMAT=md
